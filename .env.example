# Copie para .env.local e preencha.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Contas do painel (cpf:salt:hash, separadas por vírgula). Gere cada uma com: npm run hash-senha
ADMIN_ACCOUNTS=
# Banco de dados (MongoDB)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=mara-rosa-leilao

